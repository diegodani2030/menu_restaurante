# Copie este archivo como .env y complete los valores.
# NUNCA suba el archivo .env al repositorio.

# --- Conexión a MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=raices_del_fogon

# --- Administrador inicial (lo crea `npm run db:setup`) ---
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@raices.test
ADMIN_TELEFONO=3000000000
# Mínimo 8 caracteres, con letras y números.
ADMIN_PASSWORD=
